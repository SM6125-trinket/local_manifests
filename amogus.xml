<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <remote name="sm6125-trinket"
        fetch="https://github.com/SM6125-trinket/"
        revision="refs/heads/fourteen" />
    <remote name="aospa-vendor"
        fetch="https://github.com/ThankYouMario/" />

    <!-- Unused LineageOS 21 libfmjni depends on undefined qcom_libfmjni_defaults in PixelOS;
         amogus uses packages/apps/FMRadio/jni/fmr instead.
         Upstream BtHelper (floating main branch) depends on missing custom-sdk module in PixelOS 14. -->
    <remove-project name="LineageOS/android_vendor_qcom_opensource_libfmjni" />
    <remove-project name="TheParasiteProject/packages_apps_BtHelper" />

    <!-- Replace upstream QCOM CAF audio (sm8150) and thermal HALs with SM6125-trinket forks -->
    <remove-project name="LineageOS/android_hardware_qcom_audio" path="hardware/qcom-caf/sm8150/audio" />
    <remove-project name="LineageOS/android_hardware_qcom_thermal" />

    <!-- Motorola Common -->
    <project path="device/motorola/common" name="android_device_motorola_common"
        remote="sm6125-trinket" />
    <project path="device/motorola/targets" name="android_device_motorola_targets"
        remote="sm6125-trinket" />
    <project path="vendor/motorola/common" name="android_vendor_motorola_common"
        remote="sm6125-trinket" />
    <project path="hardware/motorola" name="android_hardware_motorola"
        remote="sm6125-trinket" />

    <!-- Motorola Amogus (SM6125) -->
    <project path="device/motorola/amogus" name="android_device_motorola_amogus"
        remote="sm6125-trinket" />
    <project path="device/motorola/amogus-kernel" name="android_device_motorola_amogus-kernel"
        remote="sm6125-trinket" />
    <project path="kernel/motorola/msm-4.14" name="android_kernel_motorola_msm-4.14"
        remote="sm6125-trinket" />
    <project path="vendor/motorola/amogus" name="android_vendor_motorola_amogus"
        remote="sm6125-trinket" />

    <!-- Dependencies -->
    <project path="device/sony/sepolicy" name="android_device_sony_sepolicy"
        remote="sm6125-trinket" />
    <project path="vendor/sony/timekeep" name="android_vendor_sony_timekeep"
        remote="sm6125-trinket" />
    <project path="vendor/egistec/interfaces" name="platform_vendor_egistec_interfaces"
        remote="sm6125-trinket" />

    <!-- QCOM Common (dsprpcd & qseecomd blobs) -->
    <project path="vendor/qcom/common" name="proprietary_vendor_qcom_common"
        remote="aospa-vendor" revision="uvite" />

    <!-- QCOM CAF HALs (SM6125-trinket forks) -->
    <project path="hardware/qcom-caf/sm8150/audio" name="android_hardware_qcom_audio"
        groups="qcom,msmnile" remote="sm6125-trinket" />
    <project path="hardware/qcom-caf/thermal" name="android_hardware_qcom_thermal"
        groups="qcom,kailua-vendor" remote="sm6125-trinket" />
</manifest>
